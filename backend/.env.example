PORT=3000
WEBSITE_URL=http://localhost:3000/

# Database: built-in PGlite, nothing to configure. Data folder defaults to backend/data/pglite.
# PGLITE_DIR=./data/pglite   # optional: custom data folder (on Railway the Volume at /data is used automatically)

# ---- Live database backup: kept on the server, managed in Admin > Backup. Nothing is sent to GitHub or any outside service. ----
# Optional: encrypts the backup files (AES-256-GCM). Keep a copy of this secret outside the server: without it a backup cannot be restored.
BACKUP_PASSPHRASE=
# Optional: LIVE_BACKUP_EVERY_SEC=60  LIVE_KEEP_HOURLY=24  LIVE_KEEP_DAILY=7  LIVE_BACKUP_DIR=
NODE_ENV=development

# Admin JWT. Also signs the "paid subscriber" cookie for the chat assistant.
# Generate a long random value, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
ADMIN_TOKEN_EXPIRES=8h

# Upload limits
MAX_FILES=20
MAX_FILE_SIZE_MB=20

# Optional when frontend and backend are hosted on different origins.
# Leave blank for the local same-origin setup.
FRONTEND_ORIGIN=

EMAIL_TO=you@example.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
SMTP_FROM=you@example.com

# ---- Site chat assistant ----
# FREE key (no credit card) at https://console.groq.com/keys
# Leave blank locally to disable chat; required in production.
GROQ_API_KEY=
# More capacity: add the keys of up to 10 different Groq accounts (comma separated, key 1 may stay in GROQ_API_KEY above).
# The site uses the first key until it has made GROQ_CALLS_PER_MIN calls in a minute, then switches to the next key
# automatically (and also switches if Groq answers "rate limit"). Live status for admins: the "Groq keys" button in the admin console (GET /api/admin/groq-keys)
# GROQ_API_KEYS=gsk_key2,gsk_key3,gsk_key4
GROQ_API_KEYS=
GROQ_CALLS_PER_MIN=500
CHAT_MODEL=openai/gpt-oss-120b
# Optional: model used only by the "Humanize" rewriter. Leave empty to use openai/gpt-oss-20b. See https://console.groq.com/docs/models
HUMANIZE_MODEL=
# Model used only when a visitor attaches an image
CHAT_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Free allowance before the chat stops and sends the visitor to Stripe Checkout:
# FREE_CHAT_LIMIT chats OR FREE_WINDOW_MINUTES minutes after the first chat, whichever comes first.
FREE_CHAT_LIMIT=10
FREE_WINDOW_MINUTES=60

# ---- $30/month unlimited plan (Stripe) ----
# Without STRIPE_SECRET_KEY the sign-up button shows a friendly "not switched on yet" message.
STRIPE_SECRET_KEY=
# Optional: an existing recurring Price id (price_...). If blank, a $30/month price is created at checkout.
STRIPE_PRICE_ID=
# Optional: price in cents when STRIPE_PRICE_ID is blank (default 3000 = $30.00)
PRO_PRICE_CENTS=3000

# ---------------------------------------------------------------------------
# Customer accounts (signup / login / profile / subscription / orders)
# ---------------------------------------------------------------------------
# Public site address; used for the "Sign in" button inside the credentials email.
WEBSITE_URL=https://www.your-domain.com
SITE_NAME=Expert Help
# Your real domain: used for sitemap.xml, sitemap-docs.xml, robots.txt and canonical links
SITE_URL=https://assignmenthelp.site

# ---- EMAIL DELIVERY (welcome / confirm-email / password-reset / order emails) ----
# Railway BLOCKS outbound SMTP (Gmail smtp.gmail.com) on Free/Trial/Hobby plans, so email goes through
# your own mail relay (backend/scripts/mail-relay.js running on your PC, reached over HTTPS / Cloudflare Tunnel):
MAIL_PROVIDER=relay
MAIL_RELAY_URL=https://your-tunnel-address.trycloudflare.com
MAIL_RELAY_TOKEN=
MAIL_FROM=Expert Help <you@gmail.com>
# Alternative: RESEND_API_KEY=   (needs a verified domain). SMTP_* above works only on hosts that allow SMTP.

# Google sign-in: create an OAuth 2.0 "Web application" client in Google Cloud Console
# (APIs & Services > Credentials), add your site under "Authorised JavaScript origins",
# then paste the client ID here. Leave blank to hide the Google button.
GOOGLE_CLIENT_ID=
# Optional: only allow these email domains via Google (e.g. gmail.com). Blank = any Google account.
GOOGLE_ALLOWED_DOMAINS=

# Customer session length in days (default 14). Sessions are signed with a key derived from
# JWT_SECRET; set USER_JWT_SECRET only if you want a completely separate key.
USER_SESSION_DAYS=14
# USER_JWT_SECRET=

# Local testing only: if SMTP is not configured, print the credentials to the server console.
# Ignored when NODE_ENV=production.
AUTH_DEV_LOG_CREDENTIALS=false

# ---- Human live chat (no AI) ----
# Default address that receives every finished chat transcript and "new chat" alerts (falls back to EMAIL_TO).
# Agents can change it any time in the console (/agent > Settings > "Forward transcripts to").
LIVECHAT_EMAIL_TO=
# Agents answer at /agent using the same username/password as /admin (npm run create-admin).

# WhatsApp contact for the website icon. Normally set in the agent console (/agent > Settings);
# this is only the fallback used until a number is saved there. Country code first, digits only.
WHATSAPP_NUMBER=917042660369

# Free Groq models. Chat uses CHAT_MODEL; the humanizer and AI checker default to openai/gpt-oss-20b so they do not
# eat the chat's 8k tokens/min. Only set these if you want to override.
# HUMANIZE_MODEL=openai/gpt-oss-20b
# DETECT_MODEL=openai/gpt-oss-20b

# AI to Human Text: free uses per visitor/account before the $30/month plan is required (default 2)
FREE_HUMANIZE_LIMIT=2

# Free tries per visitor across all $30/month services (citations, document creator, OCR, diagrams). Default 1. 0 turns the free try off.
FREE_TOOL_USES=1

# $30 pack: 30 unlocks valid for 1 month (one-time Stripe payment)
DOC_PACK_PRICE_CENTS=3000
DOC_PACK_UNLOCKS=30
DOC_PACK_DAYS=30

# ---- Questions & Answers (/qa) ----
# QA_FREE_QUESTIONS=2            free questions per member
# QA_PASS_PRICE_CENTS=3000       membership price ($30), one Stripe payment
# QA_PASS_QUESTIONS=30           questions included in the membership
# QA_PASS_VIEWS=30               answer views included in the membership
# QA_PASS_DAYS=30                how long the membership lasts
# QA_ANSWER_CLEAR_RATIO=0.3      share of an answer everybody can read
# QA_EXPERT_EMAILS=a@x.com,b@y.com   members who may answer (or use POST /api/qa/admin/expert)
# QA_CRAWL_FULL=0                1 = hidden 70% of an answer is real (blurred) text in the HTML so search engines index it; 0 = scrambled on the server
# INDEXNOW_KEY=                  optional: tells Bing/Yahoo/Yandex about a new question or answer at once (key file is served at /<key>.txt)

# Citation Generator documents: stored on upload, live in the Document Library after N months
CITATION_PUBLISH_MONTHS=2
# CITATION_AUTOPUBLISH=0            # 0 = keep storing but never publish
# CITATION_PUBLISH_CHECK_MINUTES=60

# ---------------- Backups (Admin > Backup) ----------------
# BACKUP_PASSPHRASE=choose-a-long-passphrase      # encrypts the .zip (open with: node backend/scripts/backup-tools.js decrypt file.zip.enc)
# BACKUP_EVERY_HOURS=24
# BACKUP_MAX_EMAIL_MB=17                          # bigger files are not attached; download them in Admin > Backup
# BACKUP_SKIP_TABLES=                             # comma list of tables to leave out
# TELEGRAM_BOT_TOKEN=123456:ABC...                # optional second place to receive backups (free, up to 50 MB)
# TELEGRAM_CHAT_ID=123456789

# ---------------- Your own mail server (optional: delivery from the website process itself) ----------------
# A) Send straight from this server (needs outbound port 25 open):
# MAIL_PROVIDER=direct
# MAIL_FROM="Expert Help <support@yourdomain.com>"
# DKIM_DOMAIN=yourdomain.com
# DKIM_SELECTOR=mail
# DKIM_PRIVATE_KEY_FILE=./dkim-private.pem        # create with: node backend/scripts/make-dkim.js yourdomain.com
# MAIL_HELO=mail.yourdomain.com
# B) Website on Railway, mail sent by your own PC/VPS (run: node backend/scripts/mail-relay.js there):
# MAIL_PROVIDER=relay
# MAIL_RELAY_URL=https://mail.yourdomain.com
# MAIL_RELAY_TOKEN=a-long-random-secret

# Relay on your PC can use Gmail instead of port 25: put SMTP_USER / SMTP_PASS (App Password) in the relay machine's .env (MAIL_RELAY_MODE=direct forces own-server delivery).

