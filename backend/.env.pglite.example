# Copy to backend/.env  ->  runs the site on a LOCAL database inside the project (no Docker, no Neon).
PORT=3000
WEBSITE_URL=http://localhost:3000/
NODE_ENV=development
JWT_SECRET=change-me-local-only
ADMIN_TOKEN_EXPIRES=8h

# Optional: where the data folder lives (default backend/data/pglite)
# PGLITE_DIR=./data/pglite

# --- Railway ---
# Variables: JWT_SECRET=<long random>. No database variables are needed.
# Add a Volume mounted at /data (the database is stored in /data/pglite and survives deploys).
# Admin logins are created with  npm run create-admin  (no admin password is stored in variables).
